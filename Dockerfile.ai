FROM python:3.11-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HF_HOME=/models/cache \
    LOG_AI_OUTPUT_DIR=/app/runs OMP_NUM_THREADS=4 MKL_NUM_THREADS=4
COPY requirements.txt .
RUN pip install --no-cache-dir "torch>=2.6,<3" --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir -r requirements.txt
COPY ai_service ./ai_service
COPY api.py .
RUN mkdir -p /models/cache /app/runs && chown -R 10001:10001 /models /app
USER 10001:10001
EXPOSE 8000
CMD ["python","-m","uvicorn","api:app","--host","0.0.0.0","--port","8000","--workers","1"]

